{
	"info": {
		"_postman_id": "138f0bb6-f0a6-4dcc-8b20-1a6c4a440bac",
		"name": "Developer Collection",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login and Get Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has access token\", function () {",
									"    const responseData = pm.response.json();",
									"    pm.expect(responseData).to.have.property('access_token');",
									"    ",
									"    // Save token as environment variable",
									"    if (responseData.access_token) {",
									"        pm.environment.set(\"dev_access_token\", responseData.access_token);",
									"        console.log(\"Access token saved:\", responseData.access_token);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded",
								"type": "text"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "username",
									"value": "{{developer_user}}",
									"type": "text"
								},
								{
									"key": "password",
									"value": "{{developer_password}}",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{BASE_URL}}/api/v1/auth/login",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Secrets",
			"item": [
				{
					"name": "Get all Secrets",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has secrets array\", function () {",
									"    const responseData = pm.response.json();",
									"    pm.expect(responseData).to.be.an('array');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{dev_access_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/api/v1/secrets/",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"api",
								"v1",
								"secrets",
								""
							]
						}
					},
					"response": []
				},
				{
					"name": "Create New Secret",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 or 201\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});",
									"",
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    pm.test(\"Response has secret_id\", function () {",
									"        const responseData = pm.response.json();",
									"        pm.expect(responseData).to.have.property('secret_id');",
									"        ",
									"        // Save secret_id as environment variable",
									"        if (responseData.secret_id) {",
									"            pm.environment.set(\"secretID\", responseData.secret_id);",
									"            console.log(\"Last secret id saved:\", responseData.secret_id);",
									"        }",
									"    });",
									"} else {",
									"    console.log(\"Response:\", pm.response.text());",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{dev_access_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"test-secret-{{$timestamp}}\",\n  \"value\": \"test-value-{{$timestamp}}\",\n  \"env\": \"dev\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/v1/secrets/",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"api",
								"v1",
								"secrets",
								""
							]
						}
					},
					"response": []
				},
				{
					"name": "Update Secret Depending on ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{dev_access_token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"updated-secret-{{$timestamp}}\",\n  \"value\": \"updated-value-{{$timestamp}}\",\n  \"env\": \"dev\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/v1/secrets/{{secretID}}",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"api",
								"v1",
								"secrets",
								"{{secretID}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Delete Secret Depending on ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 or 204\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{dev_access_token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/api/v1/secrets/{{secretID}}",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"api",
								"v1",
								"secrets",
								"{{secretID}}"
							]
						}
					},
					"response": []
				}
			]
		}
	]
}