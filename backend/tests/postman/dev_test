                            "",
                            "try {",
                            "    const responseData = pm.response.json();",
                            "    if (responseData.access_token) {",
                            "        pm.environment.set('dev_access_token', responseData.access_token);",
                            "        console.log('Access token saved:', responseData.access_token);",
                            "    } else {",
